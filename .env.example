# Application Environment Configuration
APP_NAME="Lahore AI Job Application Agent"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_agent_db"
# Fallback for lightweight testing without running postgres:
# DATABASE_URL="sqlite:///./job_agent.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Security (JWT secret for authentication)
SECRET_KEY="super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Target Job Market (Phase 2 Discovery & Collection)
TARGET_CITY="Lahore"
TARGET_COUNTRY="Pakistan"
ENTRY_LEVEL_KEYWORDS="Python Developer,Backend Developer,Software Engineer,Junior Developer,AI/ML Engineer,QA Engineer,QA Automation Engineer,Software Intern,Trainee Engineer,Associate Software Engineer,Junior Software Engineer,Full Stack Developer"
JOB_SOURCES="systems_limited,arbisoft,devsinc,tintash,ten_pearls,netsol,confiz,rozee_pk,search_engine"
MAX_JOBS_PER_RUN=50
DISCOVERY_REQUEST_TIMEOUT_SECONDS=15
